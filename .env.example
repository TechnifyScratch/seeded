ANTHROPIC_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Use an available Claude Sonnet model ID; experiments pin the configured value.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Random 32+ character secret for Vercel Cron / external scheduler
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Administrative provisioning only; never NEXT_PUBLIC_. Supply one of these.
SEEDED_ACCESS_CODE=
SEEDED_ACCESS_CODE_SHA256=

# Vercel/server only: two distinct codes, each 16-256 characters.
# First use saves a name and creates an administrator. Never NEXT_PUBLIC_.
SEEDED_ACCESS_CODE_1=
SEEDED_ACCESS_CODE_2=
